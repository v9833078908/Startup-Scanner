OPENROUTER_API_KEY=your-key-here
OPENROUTER_MODEL_LIGHT=google/gemini-2.5-flash
OPENROUTER_MODEL_MEDIUM=anthropic/claude-haiku-4.5
OPENROUTER_MODEL_HEAVY=google/gemini-2.5-pro
# Search backend: "ddg" (default, free) or "exa" (best quality, needs EXA_API_KEY)
# DDG returns shorter snippets than Exa. For production use, "exa" is recommended.
# DDG mode auto-falls back to Perplexity Sonar (~$0.005/req) via OpenRouter if DDG unavailable.
SEARCH_BACKEND=ddg
# Only needed if SEARCH_BACKEND=exa
EXA_API_KEY=your-exa-key-here
LOG_LEVEL=INFO
